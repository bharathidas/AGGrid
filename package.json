{
    "name": "aggrid-web",
    "widgetName": "AGGrid",
    "version": "1.1.0",
    "description": "A Mendix data grid powered by AG Grid Community: sorting, filtering, set filters, quick search, pagination, inline editing, paste from Excel, cell ranges with fill handle and charts, row grouping (also lazy on the server), pivot mode, tree data, side panel, conditional formatting, sparklines, status bar, saved views, detail rows, styled multi-sheet Excel and CSV export, totals rows and themes.",
    "copyright": "© MX Techies 2026",
    "license": "Apache-2.0",
    "private": true,
    "mxpackage": {
        "name": "AGGrid",
        "type": "widget",
        "mpkName": "com.mxtechies.widget.web.AGGrid.mpk"
    },
    "packagePath": "com.mxtechies.widget.web",
    "marketplace": {
        "minimumMXVersion": "11.0.0",
        "appName": "AGGrid"
    },
    "config": {
        "projectPath": "../../",
        "mendixHost": "http://localhost:8080",
        "developmentPort": 3000
    },
    "engines": {
        "node": "^22.18.0"
    },
    "scripts": {
        "build": "pluggable-widgets-tools build:ts",
        "dev": "pluggable-widgets-tools start:ts",
        "lint": "pluggable-widgets-tools lint",
        "lint:fix": "pluggable-widgets-tools lint:fix",
        "test": "jest",
        "release": "pluggable-widgets-tools release:ts",
        "generate:typings": "node scripts/generate-typings.mjs",
        "harness": "node harness/build.mjs && node harness/test.mjs && node harness/test13.mjs",
        "licenses": "node scripts/check-licenses.mjs",
        "sbom": "node scripts/sbom.mjs"
    },
    "dependencies": {
        "@ag-grid-community/locale": "^36.1.0",
        "ag-grid-community": "36.1.0",
        "ag-grid-react": "36.1.0",
        "classnames": "^2.5.1",
        "fflate": "^0.8.3"
    },
    "devDependencies": {
        "@mendix/pluggable-widgets-tools": "11.12.1",
        "@types/big.js": "^6.2.2",
        "@types/jest": "^29.5.14",
        "esbuild": "^0.25.12",
        "jest": "^29.7.0",
        "puppeteer-core": "^24.43.1",
        "ts-jest": "^29.4.12"
    },
    "overrides": {
        "zip-a-folder": "6.1.4",
        "react": "19.0.0",
        "react-dom": "19.0.0",
        "@types/react": "19.0.0",
        "@types/react-dom": "19.0.0"
    },
    "resolutions": {
        "zip-a-folder": "6.1.4",
        "react": "19.0.0",
        "react-dom": "19.0.0",
        "@types/react": "19.0.0",
        "@types/react-dom": "19.0.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/bharathidas/AGGrid.git"
    },
    "homepage": "https://bharathidas.github.io/AGGrid/",
    "bugs": {
        "url": "https://github.com/bharathidas/AGGrid/issues"
    },
    "keywords": [
        "mendix",
        "ag-grid",
        "aggrid",
        "mendix-widget",
        "pluggable-widget",
        "data-grid",
        "pivot-table",
        "tree-grid",
        "excel-export",
        "datagrid2"
    ]
}
